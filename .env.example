# ─── Banco (Postgres local via docker-compose) ──────────────────────────────
# Runtime da API: role de app NÃO-superuser (RLS vale). NUNCA usar a de migrator aqui.
DATABASE_URL=postgresql+asyncpg://hubcapture_app:app_secret@localhost:5432/hubcapture
# Migrations/owner: role dona das tabelas. Só para `alembic upgrade`.
DATABASE_MIGRATOR_URL=postgresql+asyncpg://hubcapture:postgres_secret@localhost:5432/hubcapture

# Credenciais usadas pelo docker-compose (postgres superuser/owner)
POSTGRES_USER=hubcapture
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=hubcapture
# Senha da role de app criada no init (deve casar com DATABASE_URL)
APP_DB_PASSWORD=app_secret

# ─── Auth / JWT ─────────────────────────────────────────────────────────────
JWT_SECRET=troque-este-segredo-em-producao
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh
ACCESS_TOKEN_TTL=900          # segundos (15 min)
REFRESH_TOKEN_TTL=1209600     # segundos (14 dias)

# ─── Cache-first ────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=21600       # 6h — TTL do cache de propostas na consulta-avulsa

# ─── Fontes ─────────────────────────────────────────────────────────────────
TRANSFEREGOV_FF_BASE_URL=https://api.transferegov.gestao.gov.br/fundoafundo/

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Web ────────────────────────────────────────────────────────────────────
# Origem da API (sem /api/v1): o client tipado carrega o prefixo /api/v1 nos paths.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Demais fontes (calibrar rota/campos) ───────────────────────────────────
TRANSFEREGOV_ESP_BASE_URL=https://api.transferegov.gestao.gov.br/transferenciasespeciais/
TRANSFEREGOV_DISC_CSV_URL=http://repositorio.dados.gov.br/seges/detru/
FNS_CONSULTA_URL=https://consultafns.saude.gov.br/
FNDE_BASE_URL=https://www.fnde.gov.br/sigefweb/
SERPRO_BASE_URL=https://gateway.apiserpro.serpro.gov.br/

# ─── Scraping (Firecrawl) — vazio desabilita ────────────────────────────────
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ─── IA (LiteLLM) — vazio desabilita o resumo ───────────────────────────────
LLM_API_KEY=
LLM_MODEL_RESUMO=claude-haiku-4-5-20251001
