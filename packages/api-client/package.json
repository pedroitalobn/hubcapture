{
  "name": "@hub/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "gen:spec": "cd ../../apps/api && uv run python -m src.export_openapi ../../packages/api-client/openapi.json",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "build": "pnpm generate"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
